<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android 7.0の古い証明書ストアでは不足するCAを、アプリ内の全HTTPS接続で補う。 -->
    <!-- ★ 修正: この設定を追加するとAndroidManifestのusesCleartextTrafficより優先され、
         targetSdk 28以降ではcleartextTrafficPermittedが未指定時にfalseへ暗黙変更されてしまう。
         EDCB/Mirakurun/KonomiTV/EPGStationはLAN上でhttp接続する運用が前提のため、明示的に許可する。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/gts_root_r4" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
